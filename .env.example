# .env.example을 복사해 .env를 만들고 값을 채운다. .env는 커밋하지 않는다 (.gitignore).
# 로컬 실행은 현재 폴더의 .env를 읽고, Docker는 docker run --env-file .env 로 넘긴다.

# OpenAI 키 (필수). 비우면 LLM 연결 전으로 보고 트렌드마다 SOURCE_UNAVAILABLE(reason=no_llm)
LLM_API_KEY=
# vogue-handoff/0.1 서비스 인증 토큰 (운영 필수, 비밀 관리 시스템에서 주입)
# 새 /runs 경로만 검사합니다. project_08의 VOGUE_AGENT_SERVICE_BEARER_TOKEN과 같은 값을 설정하세요.
STOCK_AGENT_SERVICE_TOKEN=
# 모델 (기본 gpt-4o-mini). 바꿀 때만 앞의 #을 지우고 쓴다
# LLM_MODEL=gpt-4o-mini
# 호출 1번당 시간 제한(초, 기본 30)
# LLM_TIMEOUT=30
# 데이터 mount 위치와 맞추세요. Docker 기본값은 /data/images
# STOCK_IMAGE_DIR=data/images
# HTTP v0.1 전체 요청 상한은 project_08의 60초 timeout과 동일합니다 (변경 비권장).
