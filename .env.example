# .env.example을 복사해 .env를 만들고 값을 채운다. .env는 커밋하지 않는다 (.gitignore).
# 로컬 실행은 현재 폴더의 .env를 읽고, Docker는 docker run --env-file .env 로 넘긴다.

# OpenAI 키 (필수). 비우면 LLM 연결 전으로 보고 트렌드마다 SOURCE_UNAVAILABLE(reason=no_llm)
LLM_API_KEY=
# 모델 (기본 gpt-4o-mini). 바꿀 때만 앞의 #을 지우고 쓴다
# LLM_MODEL=gpt-4o-mini
# 호출 1번당 시간 제한(초, 기본 30)
# LLM_TIMEOUT=30

# CLIP 인덱스 경로 (기본 data/clip_index.npz, Docker는 /data/clip_index.npz로 자동 설정)
# STOCK_CLIP_INDEX_PATH=/data/clip_index.npz

# Cloudflare R2 (scripts/upload_r2.py). Keep real values in .env only.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=example-bucket
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
