# .env.example을 복사해 .env를 만들고 값을 채운다. .env는 커밋하지 않는다 (.gitignore).
# 로컬 실행은 현재 폴더의 .env를 읽고, Docker는 docker run --env-file .env 로 넘긴다.

# vogue-handoff/0.1 서비스 인증 토큰 (운영 필수, 비밀 관리 시스템에서 주입)
# inventory 경로(/v1/agents/inventory/runs)가 검사합니다. project_08의 VOGUE_AGENT_SERVICE_BEARER_TOKEN과 같은 값을 설정하세요.
VOGUE_AGENT_SERVICE_BEARER_TOKEN=

# Cloudflare R2: endpoint는 account ID로 자동 구성하고 S3 region은 auto를 사용합니다.
# R2_ENDPOINT를 쓰면 버킷 이름 없이 https://<계정ID>.r2.cloudflarestorage.com 까지만 적습니다.
# 읽기 전용 최소 권한 토큰을 배포 secret store에서 주입하세요.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_DB_KEY=
R2_IMAGE_PREFIX=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 재고 CLIP 인덱스(scripts/build_clip_index.py로 만든 npz)의 R2 key. --prepare-cache가 DB와 함께 캐시에 받는다.
# 없으면 서버는 뜨고, CLIP 유사도 필터는 요청마다 search.clip.skip_reason=no_index로 건너뜀
R2_CLIP_INDEX_KEY=
# 선택: 무신사 스냅 착샷 JPEG prefix. scripts/extract_snap_images.py로 만든 <prefix>/<HF revision>/<row>.jpg (예: musinsa-snap)
R2_SNAP_IMAGE_PREFIX=
# 선택 사항: R2 대신 로컬 CLIP 인덱스 파일 (기본 data/clip_index.npz)
# STOCK_CLIP_INDEX_PATH=
# 상품 이미지 로컬 폴백 디렉터리. R2_IMAGE_PREFIX가 비어 있으면 사용합니다.
# STOCK_IMAGE_DIR=data/images
# 선택 사항: DB·이미지 런타임 캐시. 기본값은 OS 임시 디렉터리 아래 inventory.
# STOCK_CACHE_DIR=
# 선택 사항: R2 상품 이미지 캐시 위치 (기본 STOCK_CACHE_DIR/images). 쓸 수 없으면 캐시 없이 응답한다.
# STOCK_IMAGE_CACHE_DIR=
# 선택 사항: 로컬 DuckDB 파일을 read-only로 연다(local-file 모드). 설정하면 R2 DB 설정·HEAD를 쓰지 않는다.
# STOCK_DB_PATH=
# 선택 사항: 두 inventory route의 전체 HTTP 처리 제한 시간(초, 기본 60, 0 초과 600 이하). 넘으면 504 TIMEOUT.
# 통합 배포는 180으로 둔다(Project_08은 Stock 응답을 210초까지 기다린다).
# STOCK_HANDOFF_TIMEOUT_SECONDS=180
