# .env.example을 복사해 .env를 만들고 값을 채운다. .env는 커밋하지 않는다 (.gitignore).
# 로컬 실행은 현재 폴더의 .env를 읽고, Docker는 docker run --env-file .env 로 넘긴다.

# LLM provider: openai(기본) | policy(결정적 PolicyLLM, 키·네트워크 없음 — stub 프로필·오프라인 점검용)
# STOCK_LLM_PROVIDER=openai
# OpenAI 키 (openai일 때 필수). 비우면 LLM 연결 전으로 보고 트렌드마다 SOURCE_UNAVAILABLE(reason=no_llm)
LLM_API_KEY=
# vogue-handoff/0.1 서비스 인증 토큰 (운영 필수, 비밀 관리 시스템에서 주입)
# 새 /runs 경로만 검사합니다. project_08의 VOGUE_AGENT_SERVICE_BEARER_TOKEN과 같은 값을 설정하세요.
VOGUE_AGENT_SERVICE_BEARER_TOKEN=
# 모델 (기본 gpt-4o-mini). 바꿀 때만 앞의 #을 지우고 쓴다
# LLM_MODEL=gpt-4o-mini
# 호출 1번당 시간 제한(초, 기본 30)
# LLM_TIMEOUT=30

# CLIP 인덱스 경로 (기본 data/clip_index.npz, Docker는 /data/clip_index.npz로 자동 설정)
# STOCK_CLIP_INDEX_PATH=/data/clip_index.npz

# Cloudflare R2: endpoint는 account ID로 자동 구성하고 S3 region은 auto를 사용합니다.
# 읽기 전용 최소 권한 토큰을 배포 secret store에서 주입하세요.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_DB_KEY=
R2_IMAGE_PREFIX=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 상품 이미지 로컬 폴백 디렉터리. R2_IMAGE_PREFIX가 비어 있으면 사용합니다.
# STOCK_IMAGE_DIR=data/images
# 선택 사항: DB·이미지 런타임 캐시. 기본값은 OS 임시 디렉터리 아래 stock-agent.
# STOCK_CACHE_DIR=
# 선택 사항: R2 상품 이미지 캐시 위치 (기본 STOCK_CACHE_DIR/images). 쓸 수 없으면 캐시 없이 응답한다.
# STOCK_IMAGE_CACHE_DIR=
# 선택 사항: 로컬 DuckDB 파일을 read-only로 연다(local-file 모드). 설정하면 R2 DB 설정·HEAD를 쓰지 않는다.
# STOCK_DB_PATH=
# HTTP v0.1 전체 요청 상한은 project_08의 60초 timeout과 동일합니다 (변경 비권장).
