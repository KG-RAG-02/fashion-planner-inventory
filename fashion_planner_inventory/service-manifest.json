  "manifest_version": "inventory-runtime",
  "agent_id": "stock-agent",
  "port": 8002,
  "host_bind": "127.0.0.1",
  "container_bind": "0.0.0.0",
  "host_publish": "127.0.0.1:8002:8002",
  "liveness_path": "/health/live",
