// inventory 서비스의 요청 처리 흐름 (trend 결과 1건 → 트렌드마다 상품 1개).
// @토큰@ 색은 scripts/render_diagrams.sh가 라이트·다크 테마 값으로 바꾼다.
// 모든 노드와 엣지의 근거는 docs/diagrams/CLAIMS.md에 있다.
digraph inventory_pipeline {
  graph [rankdir=TB, bgcolor="@BG@", fontname="Pretendard", fontcolor="@FG@", fontsize=13,
         nodesep=0.35, ranksep=0.42, pad=0.25, newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Pretendard", fontsize=12, fontcolor="@FG@",
         fillcolor="@SVC_FILL@", color="@SVC_LINE@", penwidth=1.3, margin="0.18,0.07"];
  edge  [fontname="Pretendard", fontsize=10, color="@FG@", fontcolor="@FG@", penwidth=1.1, arrowsize=0.7];

  orchestrator [label="orchestrator", style="rounded,dashed", fillcolor="@BG@", color="@EXT@"];

  subgraph cluster_http {
    label="HTTP 경계"; labeljust=l; style="rounded,dashed"; color="@EXT@"; fontsize=11;
    guard  [label="Bearer 인증, 엄격한 JSON\n(중복 key·NaN 거부), 요청 제한 시간"];
    adapt  [label="trend 결과 검증\napplied_filters → 시즌·카테고리·색·성별\n원본 payload SHA-256 (provenance)"];
  }

  subgraph cluster_trend {
    label="트렌드마다 (요청 순서대로)"; labeljust=l; style="rounded"; color="@SVC_LINE@"; fontsize=11;
    pair   [label="1  짝 카테고리\n사용자 카테고리의 짝 (상의 → 하의, 하의 → 상의 다음 아우터)\n없으면 트렌드 카테고리들의 공통 짝"];
    color  [label="2  색 매칭\n조합 색상표: 기준 색과 가장 많이 어울리는 색\n+ 기준 색 자체 (톤온톤)"];
    sql    [label="3  과잉재고 조회 (읽기 전용 SQL)\nvirtual_stock JOIN article_attrs\n짝 영역 · 색 · 시즌 · 고객군 · 재고 > 0\n후보 0개면 트렌드 색만 완화해 다시 조회:\n가장 많이 겹치는 색 → 하나라도 어울리는 색 → 21색 전체\n그래도 없으면 짝 영역 다음 단계"];
    sales  [label="4  최근 판매 추세\n최근 4주 vs 직전 4주, 같은 영역 후보(또래) 대비"];
    clip   [label="5  CLIP 필터 (기준 이미지가 있을 때만)\n흑백 이미지 0.6 + 소재·디테일 텍스트 0.4\n색마다 상위 10%, 최소 1개"];
    rank   [label="6  순위\n재고 금액 · 낮은 판매율 · 판매 감소 · 시즌 비중\n후보 안 백분위, 각 0.25"];
    pick   [label="7  사진이 있는 최상위 상품 선택\nreason, 템플릿 summary, 근거 E-001~E-006"];
  }

  out [label="트렌드 순서대로 이어 붙여 orchestrator에 응답 envelope\nproducts[i] ↔ trend_results[i], 공통 evidence 목록\nstatus ok / partial / no_results / error"];

  db    [label="DuckDB 스냅샷\n(읽기 전용)", shape=cylinder, fillcolor="@BG@"];
  index [label="CLIP 인덱스 (npz)\n상품별 사전 계산", shape=cylinder, fillcolor="@BG@"];
  imgs  [label="상품 사진\n로컬 폴더 또는 객체 저장소", shape=cylinder, fillcolor="@BG@"];
  ref   [label="기준 이미지\n착샷(객체 저장소)\n또는 상품 이미지(https 허용 목록)", style="rounded,dashed", fillcolor="@BG@", color="@EXT@"];

  orchestrator -> guard [label="POST /v1/agents/inventory/runs\nenvelope { input = trend 결과 }"];
  guard -> adapt;
  adapt -> pair [label="트렌드마다"];
  adapt -> out [label="upstream no_results / error:\nDB 조회 없음", style=dashed, color="@ERR@", fontcolor="@ERR@", constraint=false];
  pair -> color -> sql -> sales -> clip;
  clip -> rank [label="  건너뛴 경우(인덱스·모델·일치 없음):\l  이유를 기록하고 후보 그대로\l", fontcolor="@ERR@"];
  rank -> pick;
  sql:w -> sql:w [label="완화 ", style=dashed, color="@ERR@", fontcolor="@ERR@"];
  pick -> out;

  db -> sql [style=dotted, arrowhead=none];
  db -> sales [style=dotted, arrowhead=none];
  index -> clip [style=dotted, arrowhead=none];
  ref -> clip [style=dotted];
  imgs -> pick [style=dotted, arrowhead=none];
  { rank=same; sql; db; }
  { rank=same; clip; index; ref; }
  { rank=same; pick; imgs; }
}
